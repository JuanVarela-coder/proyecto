# ==========================================
# PLATFORM-X ANIME - ENVIRONMENT CONFIG
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=platformx
POSTGRES_PASSWORD=platformx_secret_pass
POSTGRES_DB=platformx_anime
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://platformx:platformx_secret_pass@localhost:5432/platformx_anime

# Cache & State (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage / Video Assets (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VIDEOS=anime-videos
S3_BUCKET_THUMBNAILS=anime-thumbnails
S3_BUCKET_SUBTITLES=anime-subtitles

# Message Broker / Event Bus (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Backend API
API_PORT=4000
JWT_SECRET=super_secret_jwt_key_anime_streaming_2026
CORS_ORIGIN=http://localhost:3000

# AI Orchestrator Microservice
AI_ORCHESTRATOR_PORT=8000
AI_ORCHESTRATOR_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_or_gemini_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AI_ORCHESTRATOR_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_CDN_URL=http://localhost:8080/hls
